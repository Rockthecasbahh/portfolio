{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  }
}
