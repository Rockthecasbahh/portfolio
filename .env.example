# Strapi v5 API endpoints (server-side & browser-facing)
STRAPI_BASE_URL=http://127.0.0.1:1337
PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi Page Builder (free API key from https://pagebuilder.wc8.io)
# Set the same key here and in Strapi Admin -> Settings -> Page Builder
STRAPI_PAGE_BUILDER_API_KEY=

# Optional: Read-only Strapi API Token so the visual editor can preview draft entries
STRAPI_API_TOKEN=
