{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Portfolio Projects & Work Samples (Un-Portfolio Chapters 01-05)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "chapterNumber": {
      "type": "string",
      "default": "01"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "video",
        "animation",
        "design",
        "web",
        "story",
        "podcast"
      ],
      "default": "video"
    },
    "madeFor": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "track": {
      "type": "enumeration",
      "enum": [
        "both",
        "un-policy",
        "tech-motion"
      ],
      "default": "both"
    },
    "featuredInReel": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 1
    },
    "shortDescription": {
      "type": "text"
    },
    "mandateChallenge": {
      "type": "text"
    },
    "executionCraft": {
      "type": "text"
    },
    "impactMetric": {
      "type": "string"
    },
    "thumbnail": {
      "type": "string"
    },
    "secondaryImage": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "videoYoutubeId": {
      "type": "string"
    },
    "externalUrl": {
      "type": "string"
    },
    "externalLabel": {
      "type": "string"
    },
    "tools": {
      "type": "component",
      "repeatable": true,
      "component": "shared.tool-tag"
    }
  }
}
