---
import type { GlobalHeaderData } from '../utils/types';
import { Sliders, EnvelopeSimple } from '@phosphor-icons/react';

interface Props {
  header: GlobalHeaderData;
}

const { header } = Astro.props;
---

<header class="fixed top-0 inset-x-0 z-40 h-[68px] bg-white/88 backdrop-blur-md border-b border-[#304774]/15 shadow-xs">
  <div class="max-w-[1440px] h-full mx-auto px-6 md:px-12 flex items-center justify-between gap-4">
    <a href="/#top" class="flex items-center gap-3 group">
      <span class="w-9 h-9 rounded-full bg-[#304774] text-white font-display font-extrabold text-sm flex items-center justify-center shadow-sm">
        {header.monogram || 'MC'}
      </span>
      <span class="font-display font-extrabold text-base md:text-lg text-[#172a3b] group-hover:text-[#304774] transition-colors">
        {header.fullName}
      </span>
    </a>

    <nav aria-label="Primary Navigation" class="hidden lg:flex items-center gap-7 font-mono-tech text-xs font-semibold text-[#29323e]">
      {(header.navItems || []).map((item) => (
        <a
          href={item.href}
          target={item.isExternal ? '_blank' : undefined}
          rel={item.isExternal ? 'noreferrer' : undefined}
          class="hover:text-[#1c72b4] transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      {header.cmsCta && (
        <a
          href={header.cmsCta.href}
          target={header.cmsCta.isExternal ? '_blank' : undefined}
          rel={header.cmsCta.isExternal ? 'noreferrer' : undefined}
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-[#304774]/25 bg-[#d9ebf4]/55 hover:bg-[#304774] text-[#172a3b] hover:text-white font-mono-tech text-xs font-semibold transition-colors"
        >
          <Sliders size={14} weight="bold" />
          <span>{header.cmsCta.label}</span>
        </a>
      )}
      {header.primaryCta && (
        <a
          href={header.primaryCta.href}
          target={header.primaryCta.isExternal ? '_blank' : undefined}
          rel={header.primaryCta.isExternal ? 'noreferrer' : undefined}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#304774] text-white hover:bg-[#172a3b] font-mono-tech text-xs font-bold transition-colors shadow-sm active:scale-95"
        >
          <EnvelopeSimple size={15} weight="bold" />
          <span>{header.primaryCta.label}</span>
        </a>
      )}
    </div>
  </div>
</header>
