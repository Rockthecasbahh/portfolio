---
import type { LogoWallBlock } from '../../utils/types';
import { getStrapiMediaUrl } from '../../utils/strapi-client';

interface Props {
  data: LogoWallBlock;
}

const { data } = Astro.props;
---

<section aria-label={data.ariaLabel || 'United Nations Agencies and Broadcast Partners'} class="py-6">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
    <div class="rounded-[32px] bg-white/90 backdrop-blur-md border border-[#d9ebf4] shadow-sm px-6 md:px-12 py-6 flex flex-wrap items-center justify-between gap-8">
      {(data.logos || []).map((logo) => {
        const src = getStrapiMediaUrl(logo.image, logo.imageUrl);
        return (
          <div class="h-10 sm:h-11 flex items-center justify-center opacity-85 hover:opacity-100 transition-opacity">
            <img
              src={src}
              alt={logo.alt || logo.name || 'Partner Logo'}
              loading="lazy"
              class="max-h-9 sm:max-h-10 w-auto object-contain"
            />
          </div>
        );
      })}
    </div>
  </div>
</section>
