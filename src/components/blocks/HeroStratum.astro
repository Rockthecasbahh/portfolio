---
import type { HeroStratumBlock } from '../../utils/types';
import { getStrapiMediaUrl } from '../../utils/strapi-client';
import { ArrowUpRight, FilePdf, Quotes } from '@phosphor-icons/react';

interface Props {
  data: HeroStratumBlock;
}

const { data } = Astro.props;
const portraitSrc = getStrapiMediaUrl(
  data.portraitImage,
  data.portraitImageUrl || '/assets/matteo-portrait-cutout.webp'
);
const artifactSrc = data.floatingArtifactImageUrl || '/assets/projects/locust-3d-sculpture.png';
---

<section class="min-h-[100dvh] pt-24 pb-10 flex items-center">
  <div class="max-w-[1440px] w-full mx-auto px-4 sm:px-8">
    <div class="relative">
      <!-- Layer 1: Slate-Cobalt (#304774) Stepped Spine from CV Top-Left -->
      <div
        aria-hidden="true"
        class="absolute -left-2 sm:-left-4 -top-3 bottom-6 w-[88%] rounded-tl-[72px] rounded-br-[56px] rounded-tr-2xl rounded-bl-2xl bg-[#304774] shadow-xl pointer-events-none"
      ></div>

      <!-- Layer 2: Glacier Ice-Blue (#d9ebf4) Topographic Header Stratum -->
      <div class="relative ml-3 sm:ml-7 cv-hero-slab cv-stratum-ice p-6 sm:p-10 lg:p-12 border border-white/80">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          <!-- Left Column: Strict 4-Element Hero Stack in Creative Syne Typography -->
          <div class="lg:col-span-7 space-y-5">
            {data.taglineBadge && (
              <div class="inline-block px-3.5 py-1 rounded-full bg-[#304774] text-white font-mono-tech text-xs uppercase tracking-[0.14em]">
                {data.taglineBadge}
              </div>
            )}

            <h1 class="font-display font-extrabold text-4xl sm:text-5xl xl:text-6xl tracking-tight leading-[1.04] text-[#172a3b]">
              {data.fullName}
            </h1>

            {data.quoteText && (
              <div class="relative bg-white/75 backdrop-blur-sm rounded-[28px] p-5 sm:p-6 border border-white shadow-sm">
                <Quotes size={28} weight="fill" className="text-[#304774] mb-1 opacity-85" />
                <p class="text-base md:text-lg text-[#172a3b] leading-relaxed max-w-[56ch]">
                  {data.quoteText}
                </p>
              </div>
            )}

            <div class="pt-1 flex flex-wrap items-center gap-3.5">
              {data.primaryCta && (
                <a
                  href={data.primaryCta.href}
                  target={data.primaryCta.isExternal ? '_blank' : undefined}
                  rel={data.primaryCta.isExternal ? 'noreferrer' : undefined}
                  class="px-6 py-3.5 rounded-full bg-[#304774] text-white hover:bg-[#172a3b] font-mono-tech text-xs font-bold inline-flex items-center gap-2 transition-colors shadow-md active:scale-95"
                >
                  <span>{data.primaryCta.label}</span>
                  <ArrowUpRight size={16} weight="bold" />
                </a>
              )}
              {data.secondaryCta && (
                <a
                  href={data.secondaryCta.href}
                  target={data.secondaryCta.isExternal ? '_blank' : undefined}
                  rel={data.secondaryCta.isExternal ? 'noreferrer' : undefined}
                  class="px-5 py-3.5 rounded-full bg-white border border-[#304774]/25 text-[#172a3b] hover:border-[#304774] font-mono-tech text-xs font-bold inline-flex items-center gap-2 transition-colors shadow-xs"
                >
                  <FilePdf size={16} weight="duotone" className="text-[#1c72b4]" />
                  <span>{data.secondaryCta.label}</span>
                </a>
              )}
            </div>
          </div>

          <!-- Right Column: Exact CV Coral-Apricot Portrait Circle + 3D Layer Preview -->
          <div class="lg:col-span-5 flex flex-col items-center lg:items-end justify-center">
            <div class="relative">
              <!-- Outer Topographic Elevation Ring -->
              <div
                aria-hidden="true"
                class="w-60 h-60 sm:w-72 sm:h-72 rounded-full border-2 border-dashed border-[#304774]/35 absolute -inset-3 animate-[spin_45s_linear_infinite] pointer-events-none"
              ></div>

              <!-- Warm Coral-Apricot Circle from Matteo's CV -->
              <div class="relative w-56 h-56 sm:w-64 sm:h-64 rounded-full cv-portrait-halo border-4 border-white overflow-hidden flex items-end justify-center">
                <img
                  src={portraitSrc}
                  alt={data.fullName}
                  fetchpriority="high"
                  class="w-full h-[108%] object-cover object-top drop-shadow-xl"
                />
              </div>

              <!-- Floating 3D Sculpture Artifact Thumbnail overlapping the Coral Circle -->
              {data.floatingArtifactTitle && (
                <a
                  href={data.floatingArtifactHref || '#chapter-02'}
                  class="mt-4 sm:mt-0 sm:absolute sm:-bottom-4 sm:-left-10 bg-white/95 backdrop-blur-md border border-[#304774]/20 rounded-2xl p-2.5 shadow-xl flex items-center gap-3 hover:border-[#304774] transition-colors"
                >
                  <img
                    src={artifactSrc}
                    alt={data.floatingArtifactTitle}
                    class="w-14 h-12 rounded-xl object-cover"
                  />
                  <div class="pr-2">
                    <div class="font-display font-bold text-xs text-[#172a3b]">
                      {data.floatingArtifactTitle}
                    </div>
                    <div class="font-mono-tech text-[11px] text-[#1c72b4]">
                      {data.floatingArtifactSubtitle}
                    </div>
                  </div>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
