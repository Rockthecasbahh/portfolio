---
import type { ExperienceCascadeBlock, ExperienceItem } from '../../utils/types';
import { normalizeStrapiExperience } from '../../utils/loaders';

interface Props {
  data: ExperienceCascadeBlock;
  experiences: ExperienceItem[];
}

const { data, experiences } = Astro.props;
const expList =
  Array.isArray(data.experiences) && data.experiences.length > 0
    ? data.experiences.map(normalizeStrapiExperience)
    : experiences;
---

<section id={data.sectionId || 'experience'} class="py-20">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
    <div class="mb-12 px-2">
      <h2 class="font-display font-extrabold text-3xl md:text-5xl text-[#172a3b]">
        {data.heading || 'Work Experience'}
      </h2>
      {data.subHeading && (
        <p class="text-base text-[#29323e] mt-2 max-w-[62ch]">
          {data.subHeading}
        </p>
      )}
    </div>

    <!-- Alternating Paper White -> Slate-Cobalt Wave -> Glacier Ice Wave Strata -->
    <div class="space-y-8">
      {expList.map((exp, idx) => {
        const bandType = idx % 3 === 0 ? 'paper' : idx % 3 === 1 ? 'cobalt' : 'ice';
        const isCobalt = bandType === 'cobalt';
        const isIce = bandType === 'ice';

        return (
          <article
            class={`cv-wave-slab p-6 sm:p-9 md:p-10 transition-transform duration-300 hover:-translate-y-0.5 ${
              isCobalt
                ? 'cv-stratum-cobalt'
                : isIce
                ? 'cv-stratum-ice border border-white'
                : 'cv-stratum-paper border border-[#d9ebf4]'
            }`}
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
              <!-- Left Column: Circular Agency Crest + Organization & Period -->
              <div class="lg:col-span-5 flex items-start gap-4">
                <div
                  class={`w-16 h-16 rounded-full flex items-center justify-center p-2.5 flex-shrink-0 shadow-md ${
                    isCobalt
                      ? 'bg-white'
                      : 'bg-[#f4f9fc] border border-[#304774]/20'
                  }`}
                >
                  {exp.logoPath && (
                    <img
                      src={
                        exp.logoPath === '/assets/logos/iaea-fao-white.png'
                          ? '/assets/logos/iaea-fao-navy.png'
                          : exp.logoPath.replace('-white.png', '.png')
                      }
                      alt={exp.organizationShort}
                      loading="lazy"
                      class="max-h-10 w-auto object-contain"
                    />
                  )}
                </div>

                <div>
                  <h3
                    class={`font-display font-bold text-lg md:text-xl leading-snug ${
                      isCobalt ? 'text-white' : 'text-[#172a3b]'
                    }`}
                  >
                    {exp.organization}
                  </h3>
                  <div
                    class={`font-mono-tech text-xs mt-1 ${
                      isCobalt ? 'text-[#d9ebf4]' : 'text-[#304774] font-semibold'
                    }`}
                  >
                    {exp.location} | {exp.period}
                  </div>
                  <div
                    class={`inline-block mt-2 px-3 py-1 rounded-full font-mono-tech text-xs font-bold ${
                      isCobalt
                        ? 'bg-[#d9ebf4] text-[#172a3b]'
                        : 'bg-[#304774] text-white'
                    }`}
                  >
                    {exp.roleTitle}
                  </div>
                </div>
              </div>

              <!-- Right Column: Impact Bullets -->
              <div class="lg:col-span-7 space-y-2.5">
                {exp.trackHighlight && (
                  <div
                    class={`font-mono-tech text-xs font-bold mb-2 ${
                      isCobalt ? 'text-[#fbd5cd]' : 'text-[#1c72b4]'
                    }`}
                  >
                    {exp.trackHighlight}
                  </div>
                )}
                <ul
                  class={`space-y-2 text-sm md:text-base leading-relaxed ${
                    isCobalt ? 'text-white/92' : 'text-[#29323e]'
                  }`}
                >
                  {(exp.highlights || []).map((bullet) => (
                    <li class="flex items-start gap-2.5">
                      <span
                        class={`mt-1.5 w-2 h-2 rounded-full flex-shrink-0 ${
                          isCobalt ? 'bg-[#f29f8b]' : 'bg-[#304774]'
                        }`}
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
