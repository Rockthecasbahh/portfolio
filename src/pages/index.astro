---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import PageBuilderRender from '../page-builder/PageBuilderRender';
import { buildTemplateRender, PUBLIC_STRAPI_URL } from '../page-builder/server';
import {
  getGlobalPageData,
  getLandingPageData,
  getAllProjects,
  getAllExperiences,
} from '../utils/loaders';

const [globalData, landingPage, projects, experiences] = await Promise.all([
  getGlobalPageData(),
  getLandingPageData(),
  getAllProjects(),
  getAllExperiences(),
]);

const pbRender = await buildTemplateRender(landingPage, globalData, {
  projects,
  experiences,
});
const effectiveGlobal = pbRender ? pbRender.globalData : globalData;
const rootTitle = pbRender?.data?.root?.props?.title;
const hasHeaderBlock =
  pbRender?.data?.content?.some((b: any) => b.type === 'HeaderNavigation') ?? false;
const hasFooterBlock =
  pbRender?.data?.content?.some((b: any) => b.type === 'FooterBlock') ?? false;
---

<BaseLayout
  globalData={effectiveGlobal}
  title={rootTitle || landingPage.title || effectiveGlobal.title}
  description={landingPage.description || effectiveGlobal.description}
  hideHeader={hasHeaderBlock}
  hideFooter={hasFooterBlock}
>
  {
    pbRender ? (
      <PageBuilderRender
        client:load
        data={pbRender.data}
        metadata={pbRender.metadata}
        strapiImageUrl={PUBLIC_STRAPI_URL}
      />
    ) : (
      <BlockRenderer
        blocks={landingPage.blocks}
        projects={projects}
        experiences={experiences}
      />
    )
  }
</BaseLayout>
