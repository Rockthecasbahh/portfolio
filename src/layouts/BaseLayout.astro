---
import '../styles/global.css';
import SmoothScrollAndContours from '../components/SmoothScrollAndContours';
import StudioMotionRig3D from '../components/StudioMotionRig3D';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getGlobalPageData } from '../utils/loaders';
import type { GlobalPageData } from '../utils/types';

interface Props {
  title?: string;
  description?: string;
  globalData?: GlobalPageData;
}

const resolvedGlobal = Astro.props.globalData || (await getGlobalPageData());
const pageTitle = Astro.props.title || resolvedGlobal.title;
const pageDescription = Astro.props.description || resolvedGlobal.description;
const showContours = resolvedGlobal.studio3d?.showTopographicContours !== false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="antialiased selection:bg-[#304774] selection:text-white">
    <!-- Multi-Layer Vector Topographic Contour Map from Matteo's CV + Lenis Smooth Scroll -->
    {showContours && <SmoothScrollAndContours client:load />}

    <!-- Interactive 3D Stepped Topographic Relief, Cinema Camera & Video Light Rig (Three.js + GSAP) -->
    <StudioMotionRig3D client:load settings={resolvedGlobal.studio3d} />

    <!-- Global Navigation Header (Managed in Strapi Global Single Type) -->
    <Header header={resolvedGlobal.header} />

    <!-- Page Dynamic Zone Blocks -->
    <main id="top" class="relative z-10">
      <slot />
    </main>

    <!-- Global Footer (Managed in Strapi Global Single Type) -->
    <Footer footer={resolvedGlobal.footer} />
  </body>
</html>
