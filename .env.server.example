# Environment variables for Home Server (OMV) Strapi + Cloudflare Tunnel
# Copy this to .env on your OMV server alongside docker-compose.server.yml

# Cloudflare Tunnel Token (Copy from Cloudflare Zero Trust: Networks > Tunnels > Create Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Strapi Production Secrets
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=

# Strapi Page Builder API Key
STRAPI_PAGE_BUILDER_API_KEY=b88aa5ad445af0080f9b4adfcb7b19c6
